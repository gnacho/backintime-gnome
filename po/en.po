#: bitgnome/app.py
msgid "Equipo de Back In Time · front GNOME"
msgstr "Back In Time team · GNOME frontend"

#: bitgnome/app.py
msgid "Interfaz GTK4 + libadwaita sobre el núcleo de Back In Time."
msgstr "GTK4 + libadwaita interface on top of the Back In Time engine."

#: bitgnome/app.py bitgnome/prefs.py
msgid "General"
msgstr "General"

#: bitgnome/app.py bitgnome/window.py
msgid "Tomar instantánea"
msgstr "Take snapshot"

#: bitgnome/app.py bitgnome/dialogs.py bitgnome/window.py
msgid "Restaurar"
msgstr "Restore"

#: bitgnome/app.py bitgnome/settings_sheet.py bitgnome/window.py
msgid "Ajustes"
msgstr "Settings"

#: bitgnome/app.py
msgid "Punto anterior"
msgstr "Previous point"

#: bitgnome/app.py
msgid "Punto siguiente"
msgstr "Next point"

#: bitgnome/app.py bitgnome/window.py
msgid "Volver al presente"
msgstr "Back to the present"

#: bitgnome/app.py
msgid "Salir"
msgstr "Quit"

#: bitgnome/backend.py
msgid "No se encontró el núcleo de Back In Time (common/)."
msgstr "The Back In Time engine was not found (common/)."

#: bitgnome/backend.py
#, python-brace-format
msgid "Error importando el núcleo de Back In Time: {error}"
msgstr "Error importing the Back In Time engine: {error}"

#: bitgnome/backend.py
msgid "Local cifrado (encfs)"
msgstr "Encrypted local (encfs)"

#: bitgnome/backend.py
msgid "SSH cifrado (encfs)"
msgstr "Encrypted SSH (encfs)"

#: bitgnome/backend.py
msgid "Local cifrado (gocryptfs)"
msgstr "Encrypted local (gocryptfs)"

#: bitgnome/backend.py
msgid "SSH cifrado (gocryptfs)"
msgstr "Encrypted SSH (gocryptfs)"

#: bitgnome/backend.py
#, python-brace-format
msgid "Config no válida (exit {code})"
msgstr "Invalid config (exit {code})"

#: bitgnome/backend.py bitgnome/window.py
msgid "Núcleo no disponible"
msgstr "Core not available"

#: bitgnome/backend.py
msgid "El alta guiada solo está disponible para perfiles locales"
msgstr "Guided setup is only available for local profiles"

#: bitgnome/backend.py
msgid ""
"No cambies el destino de un perfil cifrado desde aquí. Crea un perfil nuevo "
"para conservar las copias anteriores."
msgstr ""
"Do not change the destination of an encrypted profile from here. Create a "
"new profile to keep the previous backups."

#: bitgnome/backend.py
msgid ""
"El perfil actual ya tiene copias. Crea un perfil nuevo para no ocultar las "
"instantáneas sin cifrar."
msgstr ""
"The current profile already has backups. Create a new profile so the "
"unencrypted snapshots are not hidden."

#: bitgnome/backend.py bitgnome/encryption.py
msgid "Elige una carpeta nueva o vacía, o un destino Gocryptfs ya inicializado"
msgstr ""
"Choose a new or empty folder, or a Gocryptfs destination that is already set "
"up"

#: bitgnome/backend.py
msgid "Gocryptfs no está instalado"
msgstr "Gocryptfs is not installed"

#: bitgnome/backend.py bitgnome/encryption.py bitgnome/wizard.py
msgid "Escribe una contraseña para el cifrado"
msgstr "Type a password for encryption"

#: bitgnome/backend.py
msgid "Destino no válido"
msgstr "Invalid destination"

#: bitgnome/backend.py
msgid "Escribe el servidor SSH"
msgstr "Enter the SSH server"

#: bitgnome/backend.py
msgid "Escribe la ruta remota de las copias"
msgstr "Enter the remote path for the backups"

#: bitgnome/backend.py
msgid "Falta sshfs en este equipo: instálalo para usar destinos SSH"
msgstr "sshfs is missing on this machine: install it to use SSH destinations"

#: bitgnome/backend.py
#, python-brace-format
msgid "El servidor {target} no responde en 25 segundos"
msgstr "The server {target} does not answer within 25 seconds"

#: bitgnome/backend.py
#, python-brace-format
msgid "No se pudo lanzar ssh: {error}"
msgstr "Could not run ssh: {error}"

#: bitgnome/backend.py
#, python-brace-format
msgid ""
"La llave SSH no ha sido aceptada por {target}. Añádela al usuario remoto."
msgstr "The SSH key was not accepted by {target}. Add it to the remote user."

#: bitgnome/backend.py
#, python-brace-format
msgid "No se puede resolver el nombre {host}"
msgstr "Cannot resolve the name {host}"

#: bitgnome/backend.py
#, python-brace-format
msgid "No se puede conectar a {target} en el puerto {port}"
msgstr "Cannot connect to {target} on port {port}"

#: bitgnome/backend.py
#, python-brace-format
msgid "La comprobación falló: {detail}"
msgstr "The check failed: {detail}"

#: bitgnome/backend.py
#, python-brace-format
msgid "La ruta {path} existe pero no se puede escribir"
msgstr "The path {path} exists but is not writable"

#: bitgnome/backend.py
#, python-brace-format
msgid "La carpeta padre de {path} no existe o no se puede escribir"
msgstr "The parent folder of {path} does not exist or is not writable"

#: bitgnome/backend.py
msgid ""
"El servidor no tiene rsync instalado y Back In Time lo necesita allí para "
"copiar por SSH"
msgstr ""
"The server has no rsync installed and Back In Time needs it there to copy "
"over SSH"

#: bitgnome/backend.py
#, python-brace-format
msgid " · {size} libres"
msgstr " · {size} free"

#: bitgnome/backend.py
#, python-brace-format
msgid "{path} (se creará)"
msgstr "{path} (will be created)"

#: bitgnome/backend.py
#, python-brace-format
msgid "Conexión correcta con {target} · {rsync}{space} en {where}"
msgstr "Connection to {target} works · {rsync}{space} in {where}"

#: bitgnome/backend.py
msgid ""
"El perfil cifrado necesita su contraseña: desbloquéalo para poder leer las "
"copias."
msgstr ""
"The encrypted profile needs its password: unlock it to read the backups."

#: bitgnome/backend.py
#, python-brace-format
msgid "La copia se creó, pero el motor falló al terminar{detail}"
msgstr "The backup was created, but the engine failed at the end{detail}"

#: bitgnome/backend.py
#, python-brace-format
msgid "La copia falló{detail}"
msgstr "The backup failed{detail}"

#: bitgnome/dialogs.py
#, python-brace-format
msgid "Restaurar «{name}»"
msgstr "Restore \"{name}\""

#: bitgnome/dialogs.py
#, python-brace-format
msgid "Desde la instantánea «{name}»"
msgstr "From snapshot \"{name}\""

#: bitgnome/dialogs.py bitgnome/encryption.py bitgnome/wizard.py
msgid "Destino"
msgstr "Destination"

#: bitgnome/dialogs.py
msgid "Ubicación original"
msgstr "Original location"

#: bitgnome/dialogs.py
msgid "Otra carpeta…"
msgstr "Another folder…"

#: bitgnome/dialogs.py
msgid "/ruta/destino"
msgstr "/path/destination"

#: bitgnome/dialogs.py bitgnome/prefs.py
msgid "Opciones"
msgstr "Options"

#: bitgnome/dialogs.py
msgid "Crear copia de los archivos existentes"
msgstr "Back up the existing files"

#: bitgnome/dialogs.py
msgid "Renombra los actuales a archivo.backup.YYYYMMDD"
msgstr "Renames the current ones to file.backup.YYYYMMDD"

#: bitgnome/dialogs.py
msgid "Restaurar solo archivos nuevos o más recientes"
msgstr "Restore only new or newer files"

#: bitgnome/dialogs.py
msgid "Equivale a rsync --update"
msgstr "Same as rsync --update"

#: bitgnome/dialogs.py
msgid "Eliminar archivos que no están en la instantánea"
msgstr "Delete files that are not in the snapshot"

#: bitgnome/dialogs.py
msgid "Peligroso: borra archivos posteriores a la copia"
msgstr "Dangerous: deletes files newer than the backup"

#: bitgnome/dialogs.py bitgnome/encryption.py bitgnome/window.py
#: bitgnome/wizard.py
msgid "Cancelar"
msgstr "Cancel"

#: bitgnome/dialogs.py
msgid "Elige una carpeta de destino"
msgstr "Choose a destination folder"

#: bitgnome/dialogs.py
msgid "Registro de instantáneas"
msgstr "Snapshot log"

#: bitgnome/dialogs.py bitgnome/settings_sheet.py
msgid "Todo"
msgstr "Everything"

#: bitgnome/dialogs.py
msgid "Info"
msgstr "Info"

#: bitgnome/dialogs.py
msgid "Avisos"
msgstr "Warnings"

#: bitgnome/dialogs.py
msgid "Errores"
msgstr "Errors"

#: bitgnome/dialogs.py
msgid "cargando…"
msgstr "loading…"

#: bitgnome/dialogs.py
#, python-brace-format
msgid "No se pudo leer el registro: {error}"
msgstr "Could not read the log: {error}"

#: bitgnome/dialogs.py
#, python-brace-format
msgid "Cambios - {name}"
msgstr "Changes - {name}"

#: bitgnome/dialogs.py
msgid "El archivo es demasiado grande para el diff interno (más de 2 MB)."
msgstr "The file is too large for the built-in diff (more than 2 MB)."

#: bitgnome/dialogs.py
msgid "No se puede leer el archivo en la instantánea."
msgstr "Cannot read the file in the snapshot."

#: bitgnome/dialogs.py
msgid ""
"No hay una instantánea anterior con la que comparar: este es el punto más "
"antiguo."
msgstr ""
"There is no earlier snapshot to compare with: this is the oldest point."

#: bitgnome/dialogs.py
msgid "El archivo no existía en la instantánea anterior (es nuevo)."
msgstr "The file did not exist in the previous snapshot (it is new)."

#: bitgnome/dialogs.py
#, python-brace-format
msgid "anterior ({sid})"
msgstr "previous ({sid})"

#: bitgnome/dialogs.py
#, python-brace-format
msgid "actual ({sid})"
msgstr "current ({sid})"

#: bitgnome/dialogs.py
msgid "Sin diferencias con la instantánea anterior."
msgstr "No differences with the previous snapshot."

#: bitgnome/dialogs.py
msgid "Retención"
msgstr "Retention"

#: bitgnome/dialogs.py
#, python-brace-format
msgid ""
"La retención está configurada en {label}, una unidad que el motor no "
"soporta: solo aplica días, semanas y años. No se borrará ninguna instantánea."
msgstr ""
"Retention is set to {label}, a unit the engine does not support: it only "
"applies days, weeks and years. No snapshot will be deleted."

#: bitgnome/dialogs.py
msgid ""
"Cambia la conservación a 2 semanas, 1 año o 2 años para que el borrado "
"automático funcione."
msgstr ""
"Change retention to 2 weeks, 1 year or 2 years so automatic deletion works."

#: bitgnome/dialogs.py
#, python-brace-format
msgid ""
"La retención está configurada en {label}, pero este núcleo de Back In Time "
"no la aplica: removeOldSnapshotsDate() devuelve 1/1/1, así que no se borrará "
"ninguna instantánea."
msgstr ""
"Retention is set to {label}, but this Back In Time core does not apply it: "
"removeOldSnapshotsDate() returns 1/1/1, so no snapshot will be deleted."

#: bitgnome/dialogs.py
msgid ""
"No es un problema de esta aplicación: el motor instalado no ejecuta la "
"retención. No hay archivos en riesgo por borrado automático."
msgstr ""
"This is not a problem of this application: the installed engine does not run "
"retention. No files are at risk from automatic deletion."

#: bitgnome/dialogs.py
#, python-brace-format
msgid ""
"La retención está en {label}, pero ahora mismo no se puede leer el destino, "
"así que no se puede saber qué instantáneas se borrarían ni qué archivos se "
"perderían."
msgstr ""
"Retention is set to {label}, but the destination cannot be read right now, "
"so there is no way to know which snapshots would be deleted or which files "
"would be lost."

#: bitgnome/dialogs.py
msgid ""
"Conecta el destino y vuelve a revisar la retención. Las instantáneas con "
"nombre no se borran nunca."
msgstr ""
"Connect the destination and check retention again. Named snapshots are never "
"deleted."

#: bitgnome/dialogs.py
msgid ""
"{count} instantáneas anteriores al {cutoff:%d/%m/%Y} (retención: {label}) se "
"eliminarán en la próxima copia."
msgstr ""
"{count} snapshots older than {cutoff:%d/%m/%Y} (retention: {label}) will be "
"deleted on the next backup."

#: bitgnome/dialogs.py
#, python-brace-format
msgid "<b>Solo existen ahí: {n} archivos</b>"
msgstr "<b>Only exist there: {n} files</b>"

#: bitgnome/dialogs.py
msgid ""
"No se pudo leer todo el contenido (permisos o destino sin montar). No se "
"puede asegurar qué se perdería."
msgstr ""
"Not all the content could be read (permissions or destination not mounted). "
"There is no way to be sure what would be lost."

#: bitgnome/dialogs.py
msgid ""
"Hay más archivos de los que se pueden analizar de una vez. No se puede "
"asegurar qué se perdería; lista incompleta."
msgstr ""
"There are more files than can be analysed at once. There is no way to be "
"sure what would be lost, the list is incomplete."

#: bitgnome/dialogs.py
msgid ""
"Si se borran esas instantáneas, estos archivos se pierden. No hay versión "
"más reciente de ellos."
msgstr ""
"If those snapshots are deleted, these files are lost. There is no newer "
"version of them."

#: bitgnome/dialogs.py
msgid ""
"Todos los archivos de esas instantáneas existen en alguna instantánea que se "
"conserva."
msgstr "Every file in those snapshots exists in some snapshot that is kept."

#: bitgnome/dialogs.py
#, python-brace-format
msgid "Con versión en una instantánea que se conserva: <b>{n}</b>"
msgstr "With a version in a snapshot that is kept: <b>{n}</b>"

#: bitgnome/dialogs.py
msgid "Abrir ajustes"
msgstr "Open settings"

#: bitgnome/dialogs.py
msgid "Entendido"
msgstr "Got it"

#: bitgnome/dialogs.py
#, python-brace-format
msgid ""
"\n"
"… y {n} más"
msgstr ""
"\n"
"… and {n} more"

#: bitgnome/dialogs.py
msgid "Desbloquear el perfil cifrado"
msgstr "Unlock the encrypted profile"

#: bitgnome/dialogs.py
msgid "Este perfil guarda las copias cifradas"
msgstr "This profile stores the backups encrypted"

#: bitgnome/dialogs.py
msgid "Escribe la contraseña del perfil para leer las instantáneas."
msgstr "Enter the profile password to read the snapshots."

#: bitgnome/dialogs.py bitgnome/encryption.py bitgnome/wizard.py
msgid "Contraseña"
msgstr "Password"

#: bitgnome/dialogs.py
msgid "Desbloquear"
msgstr "Unlock"

#: bitgnome/encryption.py
msgid ""
"La carpeta de destino no admite escritura con tu usuario. Elige otra carpeta "
"o revisa los permisos."
msgstr ""
"The destination folder is not writable with your user. Choose another folder "
"or check the permissions."

#: bitgnome/encryption.py
msgid ""
"El disco de destino se ha desconectado o ha pasado a solo lectura durante la "
"operación. Comprueba el cable y el puerto, vuelve a conectarlo y revisa el "
"estado del disco (por ejemplo con `sudo smartctl -a` y un `fsck` de la "
"partición) antes de reintentar."
msgstr ""
"The destination drive disconnected or became read-only during the operation. "
"Check the cable and the port, plug it back in and check the drive status "
"(for example with `sudo smartctl -a` and an `fsck` of the partition) before "
"retrying."

#: bitgnome/encryption.py
msgid "Error desconocido del motor"
msgstr "Unknown engine error"

#: bitgnome/encryption.py
msgid "Cifrar copia"
msgstr "Encrypt backup"

#: bitgnome/encryption.py
msgid "Protege tus copias con una contraseña"
msgstr "Protect your backups with a password"

#: bitgnome/encryption.py
msgid "Elegir destino…"
msgstr "Choose destination…"

#: bitgnome/encryption.py
msgid "Destino cifrado actual"
msgstr "Current encrypted destination"

#: bitgnome/encryption.py
msgid "Usa una carpeta nueva o vacía"
msgstr "Use a new or empty folder"

#: bitgnome/encryption.py
msgid "Contraseña (vacía para conservar la actual)"
msgstr "Password (empty to keep the current one)"

#: bitgnome/encryption.py bitgnome/wizard.py
msgid "Contraseña del cifrado"
msgstr "Encryption password"

#: bitgnome/encryption.py bitgnome/wizard.py
msgid "Confirmar contraseña"
msgstr "Confirm password"

#: bitgnome/encryption.py bitgnome/wizard.py
msgid "Confirmar contraseña del cifrado"
msgstr "Confirm encryption password"

#: bitgnome/encryption.py bitgnome/wizard.py
msgid ""
"Guarda la contraseña en un lugar seguro: sin ella no podrás restaurar tus "
"copias."
msgstr ""
"Keep the password somewhere safe: without it you cannot restore your backups."

#: bitgnome/encryption.py
msgid "Activar cifrado"
msgstr "Turn on encryption"

#: bitgnome/encryption.py
msgid "Elegir destino cifrado"
msgstr "Choose encrypted destination"

#: bitgnome/encryption.py bitgnome/wizard.py
msgid "Las contraseñas no coinciden"
msgstr "The passwords do not match"

#: bitgnome/prefs.py bitgnome/window.py
msgid "Gestionar perfiles"
msgstr "Manage profiles"

#: bitgnome/prefs.py bitgnome/settings_sheet.py bitgnome/window.py
msgid "Núcleo de Back In Time no disponible"
msgstr "Back In Time core not available"

#: bitgnome/prefs.py
#, python-brace-format
msgid "No se pudo leer la configuración: {error}"
msgstr "Could not read the configuration: {error}"

#: bitgnome/prefs.py
msgid "Comprobando…"
msgstr "Checking…"

#: bitgnome/prefs.py
#, python-brace-format
msgid "La comprobación falló: {error}"
msgstr "The test failed: {error}"

#: bitgnome/prefs.py bitgnome/wizard.py
