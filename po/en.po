#: bitgnome/wizard.py
msgid ""
"Copias automáticas de tus carpetas importantes. Recupera cualquier archivo "
"tal como estaba ayer, la semana pasada o el año pasado. Sin nubes raras: tus "
"discos, tus reglas."
msgstr ""
"Automatic backups of your important folders. Get any file back the way it "
"was yesterday, last week or last year. No odd clouds: your drives, your "
"rules."

#: bitgnome/wizard.py
msgid "Paso 1 de 3"
msgstr "Step 1 of 3"

#: bitgnome/wizard.py
msgid "¿Qué quieres proteger?"
msgstr "What do you want to protect?"

#: bitgnome/wizard.py
msgid ""
"Elige las carpetas que no querrías perder jamás. Puedes cambiarlo cuando "
"quieras."
msgstr "Pick the folders you would hate to lose. You can change this later."

#: bitgnome/wizard.py
msgid "No se han encontrado carpetas estándar. Usa «Elegir otra carpeta…»."
msgstr "No standard folders found. Use \"Choose another folder…\"."

#: bitgnome/wizard.py
msgid "Elegir otra carpeta…"
msgstr "Choose another folder…"

#: bitgnome/wizard.py
msgid " y más"
msgstr " and more"

#: bitgnome/wizard.py
#, python-brace-format
msgid "Se mantienen además: {names}{more}"
msgstr "Also kept: {names}{more}"

#: bitgnome/wizard.py
msgid "Paso 2 de 3"
msgstr "Step 2 of 3"

#: bitgnome/wizard.py
msgid "¿Cada cuánto hacemos copia?"
msgstr "How often should we back up?"

