msgstr "Snapshot mode"

#: bitgnome/prefs.py
msgid "Dónde se guardan las copias"
msgstr "Where the backups are stored"

#: bitgnome/prefs.py
msgid "Guardar instantáneas en"
msgstr "Store snapshots in"

#: bitgnome/prefs.py bitgnome/settings_sheet.py
msgid "Cambiar…"
msgstr "Change…"

#: bitgnome/prefs.py bitgnome/settings_sheet.py
msgid "Servidor"
msgstr "Server"

#: bitgnome/prefs.py bitgnome/settings_sheet.py
msgid "Puerto"
msgstr "Port"

#: bitgnome/prefs.py bitgnome/settings_sheet.py
msgid "Usuario"
msgstr "User"

#: bitgnome/prefs.py bitgnome/settings_sheet.py
msgid "Ruta remota"
msgstr "Remote path"

#: bitgnome/prefs.py
msgid "Clave privada"
msgstr "Private key"

#: bitgnome/prefs.py
msgid "Probar la conexión"
msgstr "Test the connection"

#: bitgnome/prefs.py
msgid "Comprueba ssh, la ruta remota y que allí haya rsync"
msgstr "Checks ssh, the remote path and that rsync is there"

#: bitgnome/prefs.py
msgid "Probar"
msgstr "Test"

#: bitgnome/prefs.py
msgid "Programación"
msgstr "Schedule"

#: bitgnome/prefs.py
msgid "Programar instantáneas"
msgstr "Schedule snapshots"

#: bitgnome/prefs.py
msgid "Entrada de cron gestionada por Back In Time"
msgstr "cron entry managed by Back In Time"

#: bitgnome/prefs.py
#, python-brace-format
msgid "Cifrado {kind}"
msgstr "{kind} encryption"

#: bitgnome/prefs.py
msgid ""
"Este modo necesita un flujo guiado que todavía no está disponible. Usa "
"Gestionar perfiles con un perfil existente o crea uno nuevo antes de cambiar "
"el modo."
msgstr ""
"This mode needs a guided flow that is not available yet. Use Manage profiles "
"with an existing profile or create a new one before changing the mode."

#: bitgnome/prefs.py bitgnome/settings_sheet.py
msgid "Elegir carpeta de destino"
msgstr "Choose destination folder"

#: bitgnome/prefs.py
msgid "Incluir"
msgstr "Include"

#: bitgnome/prefs.py
msgid "Carpetas y archivos a respaldar"
msgstr "Folders and files to back up"

#: bitgnome/prefs.py
msgid "rsync enlaza los archivos sin cambios: no ocupan espacio extra."
msgstr "rsync links files without changes: they take no extra space."

#: bitgnome/prefs.py
msgid "Añadir…"
msgstr "Add…"

#: bitgnome/prefs.py
msgid "Carpeta…"
msgstr "Folder…"

#: bitgnome/prefs.py
msgid "Archivo…"
msgstr "File…"

#: bitgnome/prefs.py bitgnome/window.py
msgid "carpeta"
msgstr "folder"

#: bitgnome/prefs.py
msgid "archivo"
msgstr "file"

#: bitgnome/prefs.py bitgnome/settings_sheet.py bitgnome/wizard.py
msgid "Añadir a la copia"
msgstr "Add to backup"

#: bitgnome/prefs.py
msgid "Excluir"
msgstr "Exclude"

#: bitgnome/prefs.py
msgid "Patrones de exclusión"
msgstr "Exclusion patterns"

#: bitgnome/prefs.py
msgid "Comodines de rsync: * dentro de un nivel, ** a cualquier profundidad."
msgstr "rsync wildcards: * within one level, ** at any depth."

#: bitgnome/prefs.py
msgid "Nuevo patrón o ruta…"
msgstr "New pattern or path…"

#: bitgnome/prefs.py
msgid "Por tamaño"
msgstr "By size"

#: bitgnome/prefs.py
msgid "Excluir archivos mayores de"
msgstr "Exclude files larger than"

#: bitgnome/prefs.py
msgid "Autoeliminar"
msgstr "Auto-remove"

#: bitgnome/prefs.py
msgid "Antigüedad"
msgstr "Age"

#: bitgnome/prefs.py
msgid "Eliminar instantáneas más antiguas de"
msgstr "Delete snapshots older than"

#: bitgnome/prefs.py bitgnome/retention.py bitgnome/settings_sheet.py
msgid "días"
msgstr "days"

#: bitgnome/prefs.py bitgnome/retention.py bitgnome/settings_sheet.py
msgid "semanas"
msgstr "weeks"

#: bitgnome/prefs.py bitgnome/retention.py bitgnome/settings_sheet.py
msgid "años"
msgstr "years"

#: bitgnome/prefs.py
msgid "Eliminación inteligente"
msgstr "Smart removal"

#: bitgnome/prefs.py
msgid "Tras cada instantánea se aplica este patrón de conservación."
msgstr "This retention pattern is applied after every snapshot."

#: bitgnome/prefs.py
msgid "Conservar solo lo que indica el patrón"
msgstr "Keep only what the pattern says"

#: bitgnome/prefs.py
msgid "Conservar todas durante (días)"
msgstr "Keep all for (days)"

#: bitgnome/prefs.py
msgid "Conservar una al día durante (días)"
msgstr "Keep one a day for (days)"

#: bitgnome/prefs.py
msgid "Conservar una a la semana durante (semanas)"
msgstr "Keep one a week for (weeks)"

#: bitgnome/prefs.py
msgid "Conservar una al mes durante (meses)"
msgstr "Keep one a month for (months)"

#: bitgnome/prefs.py
msgid "Notificaciones"
msgstr "Notifications"

#: bitgnome/prefs.py
msgid "Notificar errores y avisos"
msgstr "Notify errors and warnings"

#: bitgnome/prefs.py
msgid "Rendimiento"
msgstr "Performance"

#: bitgnome/prefs.py
msgid "Ejecutar cron con nice -n19"
msgstr "Run cron with nice -n19"

#: bitgnome/prefs.py
msgid "Menor prioridad de CPU"
msgstr "Lower CPU priority"

#: bitgnome/prefs.py
msgid "Ejecutar cron con ionice -c2 -n7"
msgstr "Run cron with ionice -c2 -n7"

#: bitgnome/prefs.py
msgid "Menor prioridad de E/S"
msgstr "Lower I/O priority"

#: bitgnome/prefs.py
msgid "Restauración y archivos"
msgstr "Restore and files"

#: bitgnome/prefs.py
msgid "Copia de seguridad antes de restaurar"
msgstr "Backup before restoring"

#: bitgnome/prefs.py
msgid "Continuar aunque haya errores"
msgstr "Continue even with errors"

#: bitgnome/prefs.py
msgid "Conserva instantáneas incompletas"
msgstr "Keeps incomplete snapshots"

#: bitgnome/prefs.py
msgid "Usar sumas de comprobación"
msgstr "Use checksums"

#: bitgnome/prefs.py
msgid "Más lento, pero más fiable que fecha+tamaño"
msgstr "Slower, but more reliable than date+size"

#: bitgnome/prefs.py
msgid "Copiar enlaces simbólicos como archivos"
msgstr "Copy symbolic links as files"

#: bitgnome/prefs.py bitgnome/settings_sheet.py
