# Maintainer: gnacho <hnacho@proton.me>

pkgname=backintime-gnome
pkgver=0.3.10
pkgrel=2
_commit=7bb7cc6e264ce94b239ff871bdb160312a0e3f73
pkgdesc="Native GNOME (GTK4 + libadwaita) frontend for Back In Time"
arch=(any)
url="https://github.com/gnacho/backintime-gnome"
license=(GPL-2.0-or-later)
optdepends=('backintime: udev-based schedules with Back In Time 1.6.x'
            'cronie: cron-based automatic backups'
            'gocryptfs: encrypted profiles with Back In Time 2.0')
depends=(backintime-cli gtk4 libadwaita python-gobject)
makedepends=(gettext)
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('56c29709f03b0d5ca103b6709c4b84c0862697c6c62aebbf490e5adf52606bf0')

package() {
  cd "$pkgname-$_commit"

  install -dm755 "$pkgdir/usr/lib/$pkgname"
  cp -a bitgnome "$pkgdir/usr/lib/$pkgname/"
  find "$pkgdir/usr/lib/$pkgname" -name '__pycache__' -prune -exec rm -rf {} +

  install -Dm755 backintime-gnome "$pkgdir/usr/bin/backintime-gnome"
  install -Dm644 com.github.bitteam.BackInTimeGNOME.desktop \
    "$pkgdir/usr/share/applications/com.github.bitteam.BackInTimeGNOME.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 icons/rewind.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/rewind.svg"
  install -Dm644 icons/rewind-128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/rewind.png"

  for catalogue in po/*.po; do
    lang=$(basename "$catalogue" .po)
    msgfmt --output-file="$pkgdir/usr/share/locale/$lang/LC_MESSAGES/$pkgname.mo" \
      "po/$catalogue"
  done

  python -m compileall -q -d "/usr/lib/$pkgname" "$pkgdir/usr/lib/$pkgname"
}
