#!/usr/bin/env python3
"""Launcher for the Back In Time GNOME frontend."""
import os
import sys

_here = os.path.dirname(os.path.abspath(__file__))
for _base in (_here, '/usr/lib/backintime-gnome'):
    if os.path.isdir(os.path.join(_base, 'bitgnome')):
        sys.path.insert(0, _base)
        break

from bitgnome.app import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
